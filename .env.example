# Copie para .env e preencha. NUNCA faça commit do .env.
# Ambiente: development | test | staging | production (sem valor = production)
APP_ENV=development
FLASK_APP=run.py

# Obrigatório fora de development/test. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sem valor em development = SQLite em instance/dev.db
# Com `docker compose up -d`: postgresql+psycopg://controle:controle@localhost:5432/controle
DATABASE_URL=

# Testes no PostgreSQL (recomendado; sem valor = SQLite em memória). O nome do banco precisa
# conter "test": a suíte RECRIA o schema public dele.
# Com docker compose: postgresql+psycopg://controle:controle@localhost:5432/controle_test
TEST_DATABASE_URL=

# Rate limit: memory:// só em development/test. Produção EXIGE Redis: REDIS_URL (Render/compose)
# vira RATELIMIT_STORAGE_URI quando esta não está definida.
RATELIMIT_STORAGE_URI=memory://
# REDIS_URL=redis://localhost:6379/0

# Senha dos usuários de `flask seed-demo` (sem valor = gerada e exibida no terminal)
DEMO_PASSWORD=

# Flags
# RLS_ENABLED=true faz o app informar a empresa ao banco (SET LOCAL app.company_id) em cada
# transação; a cobrança liga com `flask rls enable` (ADR-0003). O papel do app NÃO pode ser
# superusuário nem ter BYPASSRLS.
RLS_ENABLED=false
FEATURE_PUBLIC_API=false

# --- Fase 5: contas ---
# Base dos links nos e-mails (confirmação, reset, convite). Obrigatória fora de development/test.
APP_BASE_URL=
# E-mail: sem MAIL_BACKEND → resend se houver RESEND_API_KEY, senão console (development grava
# .eml em instance/emails/). Testes sempre usam console.
MAIL_BACKEND=
RESEND_API_KEY=
MAIL_FROM="Controle de Produção <nao-responda@seu-dominio.com.br>"
# Chave do segredo TOTP (HKDF → Fernet). Sem valor usa SECRET_KEY. Trocar invalida os MFA ativos.
MFA_ENCRYPTION_KEY=
# Proxies confiáveis na frente do app (Render = 1). 0 ignora X-Forwarded-For (forjável).
TRUSTED_PROXY_COUNT=0

# --- Fase 7: segurança e LGPD ---
# Rotação da SECRET_KEY: chaves antigas que ainda validam sessões/assinaturas (vírgula).
SECRET_KEY_FALLBACKS=
# MFA_ENCRYPTION_KEY aceita "nova,antiga" (MultiFernet) — depois rode `flask mfa-rotacionar`.
# Logs JSON em stdout (0 = texto, útil no terminal) e nível.
LOG_JSON=true
LOG_LEVEL=INFO
# Sentry opcional (vazio = desligado). Nunca envia PII, cookies, corpo nem variáveis locais.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Limites extras (formato do Flask-Limiter)
# IMPORT_RATE_LIMIT="10 per minute; 60 per hour"
# WEBHOOK_RATE_LIMIT="120 per minute"
# LGPD_EXPORT_RATE_LIMIT="3 per hour"
