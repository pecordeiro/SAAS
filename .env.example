# Copie para .env e preencha. NUNCA faça commit do .env.
# Ambiente: development | test | staging | production (sem valor = production)
APP_ENV=development
FLASK_APP=run.py

# Obrigatório fora de development/test. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sem valor em development = SQLite em instance/dev.db
# Com `docker compose up -d`: postgresql+psycopg://controle:controle@localhost:5432/controle
DATABASE_URL=

# Testes no PostgreSQL (recomendado; sem valor = SQLite em memória). O nome do banco precisa
# conter "test": a suíte RECRIA o schema public dele.
# Com docker compose: postgresql+psycopg://controle:controle@localhost:5432/controle_test
TEST_DATABASE_URL=

# Rate limit: memory:// só em development/test. Produção EXIGE Redis: REDIS_URL (Render/compose)
# vira RATELIMIT_STORAGE_URI quando esta não está definida.
RATELIMIT_STORAGE_URI=memory://
# REDIS_URL=redis://localhost:6379/0

# Senha dos usuários de `flask seed-demo` (sem valor = gerada e exibida no terminal)
DEMO_PASSWORD=

# Flags
# RLS_ENABLED=true faz o app informar a empresa ao banco (SET LOCAL app.company_id) em cada
# transação; a cobrança liga com `flask rls enable` (ADR-0003). O papel do app NÃO pode ser
# superusuário nem ter BYPASSRLS.
RLS_ENABLED=false
FEATURE_PUBLIC_API=false

# --- Fase 5: contas ---
# Base dos links nos e-mails (confirmação, reset, convite). Obrigatória fora de development/test.
APP_BASE_URL=
# E-mail: sem MAIL_BACKEND → resend se houver RESEND_API_KEY, senão console (development grava
# .eml em instance/emails/). Testes sempre usam console.
MAIL_BACKEND=
RESEND_API_KEY=
MAIL_FROM="Controle de Produção <nao-responda@seu-dominio.com.br>"
# Chave do segredo TOTP (HKDF → Fernet). Sem valor usa SECRET_KEY. Trocar invalida os MFA ativos.
MFA_ENCRYPTION_KEY=
# Proxies confiáveis na frente do app (Render = 1). 0 ignora X-Forwarded-For (forjável).
TRUSTED_PROXY_COUNT=0

# --- Fase 7: segurança e LGPD ---
# Rotação da SECRET_KEY: chaves antigas que ainda validam sessões/assinaturas (vírgula).
SECRET_KEY_FALLBACKS=
# MFA_ENCRYPTION_KEY aceita "nova,antiga" (MultiFernet) — depois rode `flask mfa-rotacionar`.
# Logs JSON em stdout (0 = texto, útil no terminal) e nível.
LOG_JSON=true
LOG_LEVEL=INFO
# Sentry opcional (vazio = desligado). Nunca envia PII, cookies, corpo nem variáveis locais.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Limites extras (formato do Flask-Limiter)
# IMPORT_RATE_LIMIT="10 per minute; 60 per hour"
# WEBHOOK_RATE_LIMIT="120 per minute"
# LGPD_EXPORT_RATE_LIMIT="3 per hour"

# Fase 8 — pagamento (Asaas). Sandbox por padrão; produção: https://api.asaas.com/v3
# Sem ASAAS_API_KEY em development/test usa o FakeProvider (em memória).
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que você cadastra no webhook do Asaas (chega no header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
# BILLING_PROVIDER=asaas|fake (vazio = automático)
BILLING_PROVIDER=

# --- Etapa F: worker (flask worker run; docs/plano/worker.md) ---
# Pausa entre ciclos do laço (s) e tentativas por evento do outbox antes de sair da fila.
WORKER_INTERVAL_SECONDS=30
WORKER_EVENT_MAX_ATTEMPTS=8
# E-mail da equipe da plataforma avisado de nova requisição de identidade visual (vazio = sem aviso).
STAFF_NOTIFY_EMAIL=

# --- Etapa G: fotos de evidência (app/services/storage.py; ADR-0011) ---
# STORAGE_BACKEND: local (disco em instance/uploads — SÓ development/test) | s3 | none.
# Vazio = local em development/test e none (fotos desligadas) em produção. Produção com fotos:
# s3 (Cloudflare R2, AWS S3 ou MinIO) com bucket PRIVADO — o app nunca gera URL pública; as
# fotos saem só por /app/fotos/<uuid> (login + empresa conferida).
STORAGE_BACKEND=
# STORAGE_LOCAL_DIR=           # padrão: instance/uploads (fora de static)
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, região "auto", endereçamento path.
# AWS: https://s3.<região>.amazonaws.com, região do bucket, endereçamento virtual.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ADDRESSING=path
# Chave com permissão SÓ de PutObject/GetObject/DeleteObject neste bucket. Nunca em código/log.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_TIMEOUT_SECONDS=10
# Limites (backend): fotos por atividade e por empresa; upload por pessoa/IP.
# PHOTOS_MAX_PER_ACTIVITY=20
# PHOTOS_MAX_PER_COMPANY=5000
# PHOTO_UPLOAD_RATE_LIMIT="30 per minute; 300 per hour"

# --- ADR-0019: briefing de identidade visual e agendamento da ligação ---
# Limites das rotas novas (POST) em /app/identidade-visual: por IP e por empresa da sessão.
# VISUAL_RATE_LIMIT_IP="20 per minute; 200 per hour"
# VISUAL_RATE_LIMIT_COMPANY="30 per minute; 300 per hour"
# Rotas novas do /interno (horários e reservas), por IP.
# INTERNO_RATE_LIMIT="60 per minute"
# Fotos de produto por briefing (o logo é 1) e antecedência mínima da ligação (minutos).
# BRIEFING_PHOTOS_MAX=10
# CALL_MIN_LEAD_MINUTES=60

# --- Etapa H: deploy e lançamento (render.yaml; docs/plano/lancamento.md e operacao.md) ---
# E-mail de atendimento mostrado em /contato. Em produção NÃO pode ser o de exemplo
# (`flask config-check` reprova).
CONTACT_EMAIL=
# Conferência da configuração (também roda no preDeployCommand do Render):
#   flask config-check            # offline: lista tudo que falta/está inseguro; exit 1 se houver erro
#   flask config-check --online   # + banco, papel do banco, RLS, migrations, Redis
#   flask config-check --online --strict   # go-live: avisos também reprovam
#   python scripts/config_check.py          # mesma coisa SEM subir o app (quando o boot já falha)
# Teste de e-mail e de fotos (nunca imprimem segredo):
#   flask mail-test voce@seudominio.com.br
#   flask storage-test
#   flask worker status --check    # exit 1 se há evento esgotado ou fila parada
# Gunicorn (gunicorn.conf.py): PORT (Render injeta), WEB_CONCURRENCY=2, GUNICORN_THREADS=4,
# GUNICORN_TIMEOUT=30, GUNICORN_LOG_LEVEL=warning.

# Backup lógico diário (scripts/backup_dump.sh, Cron Job controle-backup). Bucket SEPARADO do
# das fotos. BACKUP_AGE_RECIPIENT é a chave PÚBLICA (age1...); a privada fica offline com o dono.
# BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=
# Assinatura do backup (ssh-keygen -Y sign). BACKUP_SIGN_KEY = chave PRIVADA de assinatura (ed25519, sem senha),
# dedicada, que NÃO é credencial do bucket. A PÚBLICA fica com o dono para restaurar (BACKUP_SIGN_PUBKEY).
BACKUP_SIGN_KEY=
# BACKUP_ALLOW_UNSIGNED=1   # só dev; produção recusa backup sem assinatura
# BACKUP_SIGN_PUBKEY=ssh-ed25519 AAAA...   # só no computador de restauração
# BACKUP_RETENTION_DAYS=30       # docs/plano/lgpd.md
# BACKUP_PREFIX=db/
# Teste de restauração (scripts/backup_restore_check.sh): servidor onde criar o banco temporário
# (com CREATE DATABASE) e a fonte a comparar. NUNCA aponte RESTORE_ADMIN_URL para produção.
RESTORE_ADMIN_URL=
# SOURCE_DATABASE_URL=
# AGE_IDENTITY_FILE=             # chave privada age, só para restaurar um .age
