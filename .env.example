# Copie para .env (nunca versionar). No n8n, prefira o gerenciador de Credentials.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_SHEET_ID=
# Token secreto exigido pelos webhooks da UI de revisão (gere um valor longo e aleatório)
REVIEW_UI_TOKEN=
# Dados do remetente usados na assinatura dos rascunhos
SENDER_NAME=
SENDER_CONTACT=
# Publique apenas links reais; vazio = material não é citado nos e-mails
LINK_APRESENTACAO=
LINK_SITE=
LINK_FORMULARIO=

# App local (npm start)
PORT=3000
DB_PATH=data/montco.sqlite
# anthropic (padrão) ou mock (SIMULADO, só para testar a interface)
AI_MODE=anthropic
# Opcional: exige ?token=... no primeiro acesso
APP_TOKEN=
